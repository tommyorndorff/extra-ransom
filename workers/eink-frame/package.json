{
  "name": "eink-frame-worker",
  "private": true,
  "version": "1.0.0",
  "description": "Cloudflare Worker + D1 backend for the e-ink gift frames (weather + poem/message of the day)",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "migrate:local": "wrangler d1 migrations apply eink-frame --local --persist-to .wrangler/state",
    "migrate:remote": "wrangler d1 migrations apply eink-frame --remote",
    "deploy": "wrangler deploy",
    "test": "/opt/homebrew/bin/node --test test/"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "type": "module"
}
